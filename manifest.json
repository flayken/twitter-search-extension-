{
  "manifest_version": 3,
  "name": "Top 3 Tweets \u2013 Minimal",
  "version": "36.10.0",
  "description": "Same\u2011tab. Live Top 3 with advanced filters. Pin mini window. Auto-scroll optional.",
  "action": {
    "default_title": "Top 3 Tweets",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "notifications",
    "windows"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}