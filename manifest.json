{
  "manifest_version": 3,
  "name": "Top 3 Tweets \u2013 Minimal",
  "version": "37.0.0",
  "description": "Same\u2011tab or mini window. Live Top 3. Advanced filters. Auto\u2011scroll optional. Monotonic scores & live updates.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Top 3 Tweets"
  },
  "permissions": [
    "activeTab",
    "notifications",
    "scripting",
    "storage",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}